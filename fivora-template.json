{
  "framework": "nextjs-static-export",
  "version": 2,
  "visualEditing": {
    "contractVersion": 1,
    "mode": "strict",
    "controlOnlyPaths": [
      "common.newsletterDescription",
      "products[*].id",
      "products[*].isAvailable",
      "services[*].id",
      "products[*].currency",
      "about.collageImages[*].id",
      "products[*].showPrice",
      "products[*].isPriceRange",
      "products[*].minPrice",
      "products[*].maxPrice",
      "products[*].priceRange",
      "products[*].collectionTag",
      "products[*].material",
      "products[*].composition",
      "products[*].gsm",
      "products[*].dimensions",
      "products[*].careInstructions",
      "products[*].sizesText",
      "products[*].galleryImages",
      "products[*].colors[*].name",
      "products[*].colors[*].hex",
      "home.silkIntro.enabled",
      "home.silkIntro.durationMs",
      "home.categories[*].id",
      "home.testimonials[*].id",
      "home.shopTheLook.hotspots[*].id",
      "home.shopTheLook.hotspots[*].productId",
      "home.shopTheLook.hotspots[*].x",
      "home.shopTheLook.hotspots[*].y",
      "home.journalPosts[*].id",
      "home.journalPosts[*].body",
      "services[*].showPrice",
      "cartPage.checkoutLabel",
      "checkoutPage.submitLabel",
      "contact.whatsapp"
    ]
  },
  "siteDataFile": "src/data/site-data.json",
  "outputDirectory": "out",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "basePathEnvVar": "NEXT_PUBLIC_SITE_BASE_PATH",
  "pages": [
    {
      "id": "home",
      "label": "Home",
      "route": "/",
      "required": true
    },
    {
      "id": "shop",
      "label": "Shop",
      "route": "/shop"
    },
    {
      "id": "cart",
      "label": "Shopping Bag",
      "route": "/cart"
    },
    {
      "id": "checkout",
      "label": "Checkout",
      "route": "/checkout"
    },
    {
      "id": "about_us",
      "label": "About Us",
      "route": "/about_us"
    },
    {
      "id": "services",
      "label": "Collections & Services",
      "route": "/services"
    },
    {
      "id": "contact",
      "label": "Contact",
      "route": "/contact"
    },
    {
      "id": "announcement_bar_preview",
      "label": "Announcement Bar Preview",
      "route": "/announcement-bar-preview"
    },
    {
      "id": "countdown_preview",
      "label": "Countdown Preview",
      "route": "/countdown-preview"
    },
    {
      "id": "silk_intro_preview",
      "label": "Silk Intro",
      "route": "/silk-intro-preview"
    }
  ],
  "editorSchema": {
    "version": 1,
    "sections": [
